{
  "projectName": "search-addon-clean-install",
  "framework": "React",
  "blank": true,
  "packageManager": "bun",
  "toolchain": "biome",
  "addOnConfig": {
    "drizzle": {
      "database": "postgresql"
    }
  },
  "expectedOfficialAddOns": [
    "drizzle"
  ],
  "forbiddenOfficialAddOns": [
    "better-auth",
    "postgres-jobs",
    "api-platform",
    "observability",
    "object-storage",
    "email",
    "webhooks",
    "audit-log",
    "cache-coordination"
  ],
  "expectedFiles": [
    "src/db/index.ts",
    "src/db/schema.ts",
    "src/integrations/search/schema.ts",
    "src/integrations/search/validation.ts",
    "src/integrations/search/search.server.ts",
    "scripts/search-smoke.ts",
    "scripts/search-clean-fixture.ts",
    "capabilities/search/CAPABILITY.md"
  ],
  "verificationCommands": [
    [
      "bun",
      "scripts/search-clean-fixture.ts"
    ]
  ],
  "build": true,
  "postBuildVerificationCommands": [
    [
      "bun",
      "scripts/search-clean-fixture.ts",
      "verify"
    ]
  ],
  "cleanupCommands": [
    [
      "bun",
      "scripts/search-clean-fixture.ts",
      "cleanup"
    ]
  ]
}
