{
  "projectName": "invoice-ninja-clean-install",
  "framework": "React",
  "blank": true,
  "packageManager": "bun",
  "toolchain": "biome",
  "addOnConfig": {
    "drizzle": {
      "database": "postgresql"
    }
  },
  "expectedOfficialAddOns": [
    "postgres-jobs",
    "webhooks"
  ],
  "expectedFiles": [
    "src/integrations/invoice-ninja/service.server.ts",
    "src/lib/invoice-ninja.server.ts",
    "drizzle/0009_invoice_ninja_v1.sql"
  ],
  "verificationCommands": [
