  ],
  "build": true,
  "verificationEnvironment": {
    "DATABASE_URL": "${DATABASE_URL}",
    "NODE_ENV": "test"
  },
  "referenceVerification": {
    "installedPath": "src/lib/invoice-ninja.server.ts",
    "commands": [
      [
        "bun",
        "run",
        "invoice-ninja:unit"
      ],
      [
        "bun",
        "run",
        "invoice-ninja:smoke"
      ]
    ]
  }
}
