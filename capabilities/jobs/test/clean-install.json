{
  "projectName": "jobs-addon-clean-install",
  "framework": "React",
  "blank": true,
  "packageManager": "bun",
  "toolchain": "biome",
  "addOnConfig": {
    "drizzle": {
      "database": "postgresql"
    }
  },
  "expectedOfficialAddOns": [
    "drizzle"
  ],
  "expectedFiles": [
    "src/db/index.ts",
    "src/integrations/jobs/boss.server.ts",
    "src/integrations/jobs/client.server.ts",
    "src/integrations/jobs/registry.ts",
    "src/integrations/jobs/tasks/starter-echo.ts",
    "src/integrations/jobs/types.ts",
    "src/integrations/jobs/worker.server.ts",
    "scripts/jobs-doctor.ts",
    "scripts/jobs-migrate.ts",
    "scripts/jobs-smoke.ts",
    "scripts/jobs-worker.ts",
    "capabilities/jobs/CAPABILITY.md",
    "scripts/jobs-lifecycle-fixture.ts",
    "scripts/jobs-transaction-fixture.ts"
  ],
  "build": true,
  "verificationCommands": [
    [
      "bun",
      "x",
      "tsc",
      "--noEmit"
    ],
    [
      "bun",
      "scripts/jobs-lifecycle-fixture.ts"
    ]
  ],
  "expectedFileText": {
    "src/integrations/jobs/boss.server.ts": [
      "role === 'migration'",
      "role === 'worker'",
      "ROUTING_QUERY_OPTIONS",
      "decodeURI(url.pathname)"
    ],
    "src/integrations/jobs/worker.server.ts": [
      "includeMetadata: true",
      "retryLimit: job.retryLimit",
      "signal: job.signal"
    ],
    "src/integrations/jobs/types.ts": [
      "context?: JobHandlerContext"
    ]
  }
}
