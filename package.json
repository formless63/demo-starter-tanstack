    "jobs:smoke": "bun scripts/jobs-smoke.ts",
    "agents:check": "bun scripts/agents-check.ts",
    "agents:test": "vitest run --config scripts/agents-vitest.config.ts",
    "email:check": "bun scripts/email-check.ts",
    "email:smoke": "bun scripts/email-smoke.ts",
    "email:unit": "bun test src/integrations/email",
    "email:compat": "bun scripts/email-compat.ts",
    "email:dev:mailpit": "bun scripts/email-dev.ts up",
    "email:dev:down": "bun scripts/email-dev.ts down",
    "webhooks:unit": "bun scripts/webhooks-unit.ts",
