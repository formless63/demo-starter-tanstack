    "@tanstack/react-start": "^1.168.58",
    "better-auth": "^1.7.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.9",
    "drizzle-orm": "^0.45.1",
    "nitro": "3.0.260610-beta",
    "nodemailer": "10.0.13",
    "openai": "7.25.0",
    "pg": "^8.16.3",
    "pg-boss": "12.35.0",
    "pino": "10.3.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "redis": "6.3.0",
