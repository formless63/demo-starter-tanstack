    "cache:check": "bun scripts/cache-check.ts",
    "cache:smoke": "bun scripts/cache-smoke.ts",
    "cache:unit": "bun scripts/cache-unit.ts",
    "cache:compat": "bun scripts/cache-compat.ts",
    "cache:dev:valkey": "bun scripts/cache-dev.ts valkey",
    "cache:dev:down": "bun scripts/cache-dev.ts down",
    "cache:telemetry": "bun scripts/cache-telemetry.ts",
    "add-ons:preflight": "bun scripts/add-ons.ts preflight",
    "add-ons:test:composition": "bun scripts/add-ons.ts test-composition fixtures/add-ons/database-composition.json",
    "db:persistence:test": "bun scripts/postgres-persistence.ts",
    "project:check": "bun scripts/project.ts check",
    "project:status": "bun scripts/project.ts status",
    "theme:check": "bun scripts/theme.ts check",
    "theme:import": "bun scripts/theme.ts import",
    "theme:apply": "bun scripts/theme.ts apply",
    "project:test": "bun test scripts/project.test.ts scripts/theme.test.ts src/lib/color-mode.test.ts",
    "ai:unit": "bun scripts/ai-unit.ts",
    "ai:compat": "bun scripts/ai-compat.ts",
    "ai:reference:smoke": "bun scripts/ai-reference-smoke.ts"
