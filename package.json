  "engines": {
    "node": ">=24.0.0",
    "bun": ">=1.4.2"
  },
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --host 127.0.0.1 --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "start": "node scripts/start.mjs",
    "preview": "vite preview",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "auth:provision": "bun scripts/provision-oidc.ts",
    "capabilities:check": "bun scripts/capabilities-check.ts",
    "capabilities:status": "bun scripts/capabilities-status.ts",
    "add-ons:compile": "bun scripts/add-ons.ts compile",
    "add-ons:test": "bun scripts/add-ons.ts test",
    "add-ons:matrix": "bun scripts/add-ons.ts matrix",
