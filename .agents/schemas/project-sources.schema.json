{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "type": {
            "type": "string",
            "enum": [
              "repository-file",
              "public-url",
              "external-material",
              "design-document",
              "migration-source"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^(?!\\/)(?![A-Za-z]:)(?!.*(?:^|\\/)\\.\\.?($|\\/))[A-Za-z0-9_. -]+(?:\\/[A-Za-z0-9_. -]+)*$"
          },
          "url": {
            "type": "string",
            "maxLength": 2000,
            "format": "uri"
          },
          "reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$"
          }
        },
        "required": [
          "id",
          "type",
          "title"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "entries"
  ],
  "additionalProperties": false
}
