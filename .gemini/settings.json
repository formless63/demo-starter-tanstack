{
  "context": {
    "fileName": "AGENTS.md"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$GEMINI_PROJECT_DIR/.agents/hooks/run.sh\" session gemini \"$GEMINI_PROJECT_DIR\"",
            "timeout": 15000,
            "name": "project-session"
          }
        ],
        "matcher": "startup|resume|clear"
      }
    ],
    "BeforeTool": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$GEMINI_PROJECT_DIR/.agents/hooks/run.sh\" guard gemini \"$GEMINI_PROJECT_DIR\"",
            "timeout": 15000,
            "name": "project-guard"
          }
        ],
        "matcher": "run_shell_command|write_file|replace"
      }
    ],
    "AfterAgent": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$GEMINI_PROJECT_DIR/.agents/hooks/run.sh\" quality gemini \"$GEMINI_PROJECT_DIR\"",
            "timeout": 15000,
            "name": "project-quality"
          }
        ]
      }
    ]
  }
}
