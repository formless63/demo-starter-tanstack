# Required in production. Development defaults match compose.yaml.
DATABASE_URL=postgresql://starter:starter@localhost:5432/starter
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
APP_BASE_URL=http://localhost:3000

# At least one sign-in provider should be configured.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Optional development-only magic-link logging fallback.
MAGIC_LINK_ENABLED=false
VITE_APP_NAME=Launchpad

# Optional Compose overrides for host ports and the shared application image.
APP_PORT=3000
POSTGRES_PORT=5432
APP_IMAGE=tanstack-launchpad:local

# Used only by `bun run auth:provision`.
DEV_OIDC_ADMIN_URL=
DEV_OIDC_API_KEY=
