# Required in production. Development defaults match compose.yaml.
DATABASE_URL=postgresql://starter:starter@localhost:5432/starter
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
APP_BASE_URL=http://localhost:3000

# At least one sign-in provider should be configured.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Optional SMTP-delivered magic links. Enable only with complete Email settings.
MAGIC_LINK_ENABLED=false
VITE_APP_NAME=Launchpad

# Optional Email: lazy unless used or magic links are enabled. Never logs messages.
# Local Mailpit: start explicitly with email:dev:mailpit; no forwarding/relay.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURITY=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
EMAIL_REPLY_TO_ADDRESS=
EMAIL_REPLY_TO_NAME=
EMAIL_MAX_RECIPIENTS=50

# Optional Compose overrides for host ports and the shared application image.
APP_PORT=3000
POSTGRES_PORT=5432
APP_IMAGE=tanstack-launchpad:local

# PostgreSQL-backed jobs use DATABASE_URL unless a separate URL is supplied.
PGBOSS_DATABASE_URL=
PGBOSS_SCHEMA=pgboss
PGBOSS_USE_LISTEN_NOTIFY=false
JOBS_CONCURRENCY=4

# Optional server observability. Empty endpoints never contact a default collector.
OTEL_SERVICE_NAME=tanstack-app
OTEL_SDK_DISABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_TRACES_EXPORTER=
OTEL_METRICS_EXPORTER=
OTEL_RESOURCE_ATTRIBUTES=
APP_VERSION=
APP_REVISION=
DEPLOYMENT_ENVIRONMENT=
LOG_LEVEL=info
LOG_REDACT_FIELDS=

# Optional Storage: leave unset until used; no startup bucket mutation/readiness coupling.
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_SESSION_TOKEN=
STORAGE_FORCE_PATH_STYLE=
STORAGE_PRESIGN_TTL_SECONDS=600
STORAGE_KEY_PREFIX=

# Used only by `bun run auth:provision`.
DEV_OIDC_ADMIN_URL=
DEV_OIDC_API_KEY=

# Optional application-owned Webhooks target; resolved only when explicitly queued.
# HTTPS required. Generate a random whsec_ base64 secret using generateWebhookSecret().
WEBHOOK_REFERENCE_URL=
WEBHOOK_REFERENCE_SECRET=

# Optional server-only ephemeral Cache; first use validates/connects, never startup.
# URL may include credentials. Never put it in VITE_* variables or logs.
CACHE_URL=
CACHE_KEY_PREFIX=app
CACHE_DEFAULT_TTL_SECONDS=300
CACHE_MAX_VALUE_BYTES=1048576
# Separate disposable loopback Valkey fixture only.
CACHE_DEV_PORT=6379

# Optional AI: leave absent for normal build/start/health/worker. Configure only on use.
# AI_PROVIDER=openai-compatible
# AI_MODEL=your-explicit-model
# AI_API_KEY=server-only-secret-if-needed
# AI_BASE_URL=https://your-compatible-endpoint.example/v1
# AI_TIMEOUT_SECONDS=60

# Realtime server transport choice: sse (default), websocket, or sse,websocket.
REALTIME_TRANSPORTS=sse
# Optional Notifications ntfy adapter; no public service default.
NTFY_BASE_URL=
NTFY_TOKEN=
NTFY_TIMEOUT_SECONDS=10
# Reference-only execution-time preference resolver; replace in project code.
NTFY_REFERENCE_RECIPIENT_ID=
NTFY_REFERENCE_TOPIC=

# Privileged platform-wide operational summaries. Empty denies all; server-only IDs.
OPS_ADMIN_USER_IDS=
