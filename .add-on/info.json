{
	"id": "postgres-jobs",
	"name": "postgres-jobs",
	"displayName": "PostgreSQL Jobs",
	"description": "Typed PostgreSQL background jobs with pg-boss, Zod validation, explicit migrations, and a standalone worker.",
	"version": "1.0.0",
	"type": "add-on",
	"phase": "add-on",
	"category": "database",
	"modes": ["file-router"],
	"dependsOn": ["drizzle"],
	"packageAdditions": {
		"dependencies": {
			"drizzle-orm": "^0.45.1",
			"pg-boss": "12.35.0",
			"zod": "^4.3.6"
		},
		"scripts": {
			"jobs:worker": "bun scripts/jobs-worker.ts",
			"jobs:migrate": "bun scripts/jobs-migrate.ts",
			"jobs:doctor": "bun scripts/jobs-doctor.ts",
			"jobs:smoke": "bun scripts/jobs-smoke.ts"
		}
	},
	"author": "TanStack Launchpad",
	"license": "MIT",
	"envVars": [
		{
			"name": "PGBOSS_DATABASE_URL",
			"description": "Optional jobs-specific PostgreSQL URL; defaults to DATABASE_URL.",
			"required": false,
			"secret": true,
			"file": ".env.local"
		},
		{
			"name": "PGBOSS_SCHEMA",
			"description": "Dedicated pg-boss PostgreSQL schema.",
			"required": false,
			"default": "pgboss",
			"secret": false,
			"file": ".env.local"
		},
		{
			"name": "PGBOSS_USE_LISTEN_NOTIFY",
			"description": "Opt in to LISTEN/NOTIFY wakeups with polling fallback.",
			"required": false,
			"default": "false",
			"secret": false,
			"file": ".env.local"
		},
		{
			"name": "JOBS_CONCURRENCY",
			"description": "Per-queue worker concurrency.",
			"required": false,
			"default": "4",
			"secret": false,
			"file": ".env.local"
		}
	]
}
